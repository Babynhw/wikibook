# Copy to backend/.env and adjust for your machine.

NODE_ENV=development
PORT=4000
HOST=127.0.0.1

# Postgres from docker-compose.yml (pgvector/pgvector:pg16)
DATABASE_URL=postgresql://wikibooklm:wikibooklm@localhost:5432/wikibooklm?schema=public

# Redis from docker-compose.yml (BullMQ backing store, used from Phase 2)
REDIS_URL=redis://localhost:6379

# --- Embeddings ---
# HuggingFace's serverless Inference API. The token needs the "Make calls to
# Inference Providers" permission: https://huggingface.co/settings/tokens
# The server refuses to boot without it — there is no unauthenticated path.
HF_API_KEY=
# The inference router. Point this at a dedicated HF Inference Endpoint or a
# self-hosted TEI to move off the shared serverless fleet; the request shape
# (POST <base>/models/<model>/pipeline/feature-extraction) is the same.
HF_BASE_URL=https://router.huggingface.co/hf-inference
# The Hub, used only by /health to validate the token without spending quota.
HF_HUB_URL=https://huggingface.co
# Must be a model with a *live serverless inference provider* — most models on
# the Hub have none, `nomic-ai/nomic-embed-text-v1.5` among them. Other 768-dim
# models that are served: google/embeddinggemma-300m,
# ibm-granite/granite-embedding-278m-multilingual, BAAI/bge-base-en-v1.5
# (English only).
EMBEDDING_MODEL=intfloat/multilingual-e5-base
# Baked into the Prisma schema as vector(768) — changing it needs a migration + re-embed.
EMBEDDING_DIM=768
# Asymmetric models want a task prefix on every input. These are e5's; bge and
# nomic word theirs differently, and a symmetric model sets both blank (blank is
# honoured, not ignored). Changing either invalidates every stored vector, so
# re-embed with `pnpm reprocess:sources --all`.
# Quoted: dotenv strips trailing whitespace from an unquoted value, and the
# trailing space is part of the prefix.
EMBEDDING_QUERY_PREFIX="query: "
EMBEDDING_PASSAGE_PREFIX="passage: "

# --- Embedding latency (PRD §19) ---
# Every answer re-embeds the question through HF's serverless API, which is the
# single biggest variable cost in retrieval: a cold placement stalls before the
# model is even asked. Two levers:
#   * A small in-process cache of single-input embeddings so a re-asked question
#     or a restated follow-up skips the round-trip. Embeddings are deterministic
#     per model + prefix, so this is transparent. `0` disables it.
EMBEDDING_CACHE_SIZE=128
#   * Keep the serverless placement warm so it does not scale to idle between
#     questions and stall the first real one on a cold start. Off by default —
#     it spends one tiny inference per interval — and only helps against
#     serverless cold-start latency. Does nothing for a self-hosted TEI.
EMBEDDING_KEEP_WARM=false
EMBEDDING_KEEP_WARM_INTERVAL_MS=300000

# Sessions
SESSION_COOKIE_NAME=sid
# Sliding window, in seconds (30 days).
SESSION_TTL_SECONDS=2592000
# Password reset token lifetime, in seconds (1 hour).
PASSWORD_RESET_TTL_SECONDS=3600

# Frontend origin for CORS (the Vite dev server proxies /api, so this is a fallback).
CORS_ORIGIN=http://localhost:5173

# MinIO from docker-compose.yml — any S3-compatible store in deployment.
# The two credentials below are development defaults that are published in
# docker-compose.yml, so they are *required* when NODE_ENV=production: the server
# refuses to boot without them rather than silently using these.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=wikibooklm
S3_ACCESS_KEY_ID=wikibooklm
S3_SECRET_ACCESS_KEY=wikibooklm-secret
# MinIO has no DNS for buckets, so path-style addressing; S3-compatible stores
# may need false.
S3_FORCE_PATH_STYLE=true

# Ingestion worker (Phase 2).
# How many jobs the worker process runs at once.
INGEST_CONCURRENCY=2
# Safety valves on a single web-fetch, not tuneable product limits (PRD §5).
WEB_FETCH_TIMEOUT_MS=15000
WEB_FETCH_MAX_BYTES=2000000
# Cap on live SSE streams per user (a leaked tab must not pin connections).
SSE_MAX_CONNECTIONS_PER_USER=3

# Optional local overrides for the runtime-configurable limits (PRD §5).
# Unset values fall back to the AppConfig table seeded by prisma/seed.ts.
# PDF_MAX_BYTES=26214400
# PDF_MAX_PAGES=200
# MANUAL_MAX_CHARS=100000
# SOURCES_PER_SPACE=50

# --- Assistant (PRD §9) ---
# Which citation tier answers. `anthropic` is the `native` tier: Claude's own
# Citations feature, where a citation indexes the documents we sent and the quote
# is extracted by the API. `openai-compatible` is the `structured` tier: any
# OpenAI-shaped endpoint, where the answer is constrained to a JSON schema whose
# citation field is an enum of the indexes sent, and the quote is model-written
# and substring-verified (wiki-docs/plan/assistant-provider-tiers/design.md).
ANSWER_PROVIDER=anthropic
#
# Optional endpoint override. Examples:
#   OpenRouter's Anthropic Skin  ANSWER_PROVIDER=anthropic
#                               ANSWER_BASE_URL=https://openrouter.ai/api
#   OpenRouter chat completions  ANSWER_PROVIDER=openai-compatible
#                               ANSWER_BASE_URL=https://openrouter.ai/api/v1
#   Local Ollama                 ANSWER_PROVIDER=openai-compatible
#                               ANSWER_BASE_URL=http://localhost:11434/v1
#                               (no key needed)
ANSWER_BASE_URL=
#
# The credential. `anthropic` requires one; `openai-compatible` only needs one if
# the endpoint asks for it, so a local server can leave this blank. The server
# refuses to start when the selected provider is unusable, and names what to set.
ANSWER_API_KEY=
# Deprecated alias for ANSWER_API_KEY, honoured **only** when ANSWER_PROVIDER is
# `anthropic` — so switching providers cannot hand an Anthropic key to a
# third-party endpoint. Set ANSWER_API_KEY for anything else.
ANTHROPIC_API_KEY=
#
# OpenRouter's `require_parameters` routing guard, so the router only picks a
# provider that honours the requested response_format. Set false for a server that
# rejects unknown fields — but note that without it a router can silently answer
# unstructured prose, which produces zero citations rather than an error.
ANSWER_PROVIDER_ROUTING=true
#
ANSWER_MODEL=claude-opus-5
TITLE_MODEL=claude-haiku-4-5
# Thinking stays on; effort is the latency lever. §19 allows 8s to first display.
ANSWER_EFFORT=low
# Bounds thinking PLUS answer text.
ANSWER_MAX_TOKENS=16000
# The wire parameter that carries ANSWER_MAX_TOKENS on the `openai-compatible`
# tier. OpenAI's current models reject `max_tokens` and require
# `max_completion_tokens` (the default). A server that only accepts the older
# spelling (Ollama) should set `max_tokens`.
ANSWER_MAX_TOKENS_PARAM=max_completion_tokens
ANSWER_TIMEOUT_MS=120000
# Questions per minute per user — a cost valve, not a §5 product limit.
ANSWER_RATE_PER_MINUTE=20
# Retrieval knobs, not §5 product limits.
RETRIEVAL_TOP_K=12
RETRIEVAL_CANDIDATES=40
MAX_HISTORY_TURNS=6
