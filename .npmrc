# prisma's bundled studio depends on React 19, so pnpm hoists @types/react 19 into
# node_modules/.pnpm/node_modules — where react-router's own .d.ts files find it,
# ahead of the React 18 types the SPA declares. Every react-router element then
# fails to type-check with "cannot be used as a JSX component". Keeping these two
# out of the hoisted tree makes each package resolve the types its own peer range
# asked for; the root `pnpm.overrides` keep the SPA's copy at 18.
hoist-pattern[]=*
hoist-pattern[]=!@types/react
hoist-pattern[]=!@types/react-dom
